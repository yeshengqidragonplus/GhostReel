# Turns the files of the preview page into C++ arrays (preview_assets.h). Run by the build:
#   cmake -DROOT=<repository root> -DMANIFEST=<list file> -DOUT=<generated .cpp> -P embed_assets.cmake
# Each line of the manifest is  url|path below ROOT|content type .
file(STRINGS "${MANIFEST}" lines)
set(arrays "")
set(table "")
set(count 0)
foreach(line IN LISTS lines)
  if(line STREQUAL "")
    continue()
  endif()
  string(REPLACE "|" ";" parts "${line}")
  list(LENGTH parts n)
  if(NOT n EQUAL 3)
    message(FATAL_ERROR "embed_assets: bad manifest line '${line}'")
  endif()
  list(GET parts 0 url)
  list(GET parts 1 source)
  list(GET parts 2 type)
  if(NOT EXISTS "${ROOT}/${source}")
    message(FATAL_ERROR "embed_assets: ${ROOT}/${source} does not exist")
  endif()
  file(READ "${ROOT}/${source}" hex HEX)
  string(LENGTH "${hex}" hex_length)
  math(EXPR size "${hex_length} / 2")
  if(size EQUAL 0)
    set(bytes "0")
  else()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  endif()
  string(APPEND arrays "const unsigned char kData${count}[] = {${bytes}};\n")
  string(APPEND table "    {\"${url}\", \"${source}\", \"${type}\", kData${count}, ${size}},\n")
  math(EXPR count "${count} + 1")
endforeach()
file(WRITE "${OUT}"
  "// Generated by tools/cli/embed_assets.cmake. Do not edit.\n"
  "#include \"preview_assets.h\"\n\n"
  "namespace cli {\nnamespace {\n\n${arrays}\n}  // namespace\n\n"
  "const PreviewAsset kPreviewAssets[] = {\n${table}};\n"
  "const size_t kPreviewAssetCount = ${count};\n\n"
  "}  // namespace cli\n")
